<template><div>
    <PageHeader bind:title="props.item.id" bind:subtitle="props.item.subtitle">
      <button class="primary" if="props.item.availability === 'available' && props.item.kind === 'agent'" on:click="session">
        New Session
      </button>
      <button if="props.item.availability === 'available' && props.item.kind === 'agent'" on:click="work">
        Run once
      </button>
      <button class="primary" if="props.item.availability === 'available' && props.item.kind === 'workflow'" on:click="work">
        Start Work
      </button>
    </PageHeader>
    <div class="split">
      <div class="stack">
        <section class="panel">
          <div class="section-head">
            <h2>Overview</h2>
            <Status bind:value="props.item.availability" />
          </div>
          <div class="fact-list">
            <div class="fact">
              <span class="label">Type</span><span>{{ props.item.kind }}</span>
            </div>
            <div class="fact">
              <span class="label">Revision</span><span class="mono">{{ props.item.revision }}</span>
            </div>
          </div>
          <details class="json-details">
            <summary>View full configuration</summary>
            <pre>{{ pretty(props.item) }}</pre>
          </details>
        </section>
      </div>
      <aside class="stack">
        <section class="panel">
          <h2>Contracts</h2>
          <h3>{{ props.item.kind === 'tool' ? 'Input' : 'Objective' }}</h3>
          <pre>{{ pretty(props.item.kind === 'tool' ? props.item.input : props.item.objective) }}</pre>
          <h3>{{ props.item.kind === 'tool' ? 'Output' : 'Result' }}</h3>
          <pre>{{ pretty(props.item.kind === 'tool' ? props.item.output : props.item.result) }}</pre>
        </section>
      </aside>
    </div>
  </div></template>
<script lang="ts">
import PageHeader from '../components/PageHeader.weiv';
import Status from '../components/Status.weiv';
import { pretty, short } from '../api.ts';
export interface Props {
  item: any;
}
export let props: Props;
function session() {
  emit('new-session', props.item);
}
function work() {
  emit('start-work', props.item);
}
</script>
